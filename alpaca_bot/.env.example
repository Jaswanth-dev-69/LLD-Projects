# Copy to alpaca_bot/.env and fill in. Get keys from the Alpaca dashboard
# (Paper Trading account -> API Keys). Never commit .env.
APCA_API_KEY_ID=your-paper-key-id
APCA_API_SECRET_KEY=your-paper-secret-key

# Paper trading endpoint (default). Only change this if you mean real money,
# and then `bot.py trade` also requires --live.
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# "iex" is free; "sip" needs a paid Alpaca market-data plan.
APCA_DATA_FEED=iex
